---
import { readFileSync, existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import FeatureTable from '../../components/FeatureTable.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import CodeBox from '../../components/CodeBox.astro';
import skills from '../../data/skills.json';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { id: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;

const file = `skills/${skill.id}/SKILL.md`;
const preview = existsSync(file) ? readFileSync(file, 'utf-8').split('\n').slice(0, 14).join('\n') : '';
---
<Base title={`${skill.title} | SkillBite`} description={skill.summary} detail>
  <a class="back" href="/#skills">← 스킬 목록으로</a>
  <div class="layout">
    <header class="head">
      <span class="icon-surface detail-icon" aria-hidden="true"><img src={skill.icon} alt="" width="32" height="32" /></span>
      <div class="heading-content">
        <p class="category">{skill.category}</p>
        <h1>{skill.title}</h1>
        <p class="sub">{skill.summary}</p>
      </div>
    </header>
    <aside class="summary" aria-label="스킬 요약">
      <a class="btn" href={skill.downloadUrl} download><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg>스킬 파일 다운로드</a>
      <p class="meta free">무료 · 가입 없음 · ZIP 파일 1개</p>
      <dl class="facts">
        <div><dt>명령어</dt><dd><CodeBox text={skill.command} /></dd></div>
        <div><dt>필요한 것</dt><dd><ul>{skill.requirements.map((r) => <li>{r}</li>)}{skill.tags.map((tag) => <li>{tag}</li>)}</ul></dd></div>
        <div><dt>파일</dt><dd>글자로만 된 파일이에요. <a href="#safety">내용 확인하기</a></dd></div>
      </dl>
    </aside>
    <div class="content">
      <section class="section first" aria-labelledby="example-title">
        <h2 id="example-title">이런 결과물이 나옵니다</h2>
        {skill.exampleImages.length > 0
          ? skill.exampleImages.map((src) => (
              <a href={src} target="_blank" rel="noopener noreferrer"><img class="shot" src={src} alt={`${skill.title} 결과물 예시`} loading="lazy" /></a>
            ))
          : skill.examplePreview
            ? <article class="example-document">
                <p class="example-label">{skill.examplePreview.label}</p>
                <h3>{skill.examplePreview.title}</h3>
                <dl>{skill.examplePreview.paragraphs.map((paragraph) => <div><dt>{paragraph.label}</dt><dd>{paragraph.text}</dd></div>)}</dl>
              </article>
            : <div class="example-empty"><p class="meta">실제 결과물 예시를 준비하고 있습니다.</p></div>}
      </section>
      <SafetyBox preview={preview} />
      <FeatureTable capabilities={skill.capabilities} />
      <Steps skill={skill} />
      <Faq faqs={skill.faqs} />
      <p class="end"><a href={skill.downloadUrl} download>스킬 파일 다운로드</a> <span class="meta">무료 · 가입 없음 · ZIP 파일 1개</span></p>
    </div>
  </div>
</Base>
<style>
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-top: 24px; color: var(--text-sub); text-decoration: none; font-size: 14px; }
  .back:hover { color: var(--text); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; grid-template-areas: 'head summary' 'content summary'; column-gap: 64px; align-items: start; padding-top: 8px; }
  .head { grid-area: head; display: flex; align-items: flex-start; gap: 20px; padding-bottom: 32px; border-bottom: 1px solid var(--border); }
  .content { grid-area: content; min-width: 0; max-width: 680px; }
  .summary { grid-area: summary; position: sticky; top: 24px; padding: 24px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .detail-icon { width: 56px; height: 56px; flex: none; }
  .heading-content { min-width: 0; flex: 1; }
  .category { margin: 0 0 4px; color: var(--text-mute); font-size: 14px; font-weight: 600; }
  h1 { font-size: 36px; line-height: 1.3; letter-spacing: -0.03em; }
  .sub { margin-top: 8px; color: var(--text-sub); }
  .summary .btn { width: 100%; font-size: 17px; }
  .free { margin: 8px 0 0; text-align: center; }
  .facts { margin: 24px 0 0; padding-top: 8px; border-top: 1px solid var(--border-soft); display: block; }
  .facts > div { display: block; padding-top: 16px; }
  .facts dt { font-size: 13px; font-weight: 700; color: var(--text-mute); padding: 0 0 6px; }
  .facts dd { margin: 0; color: var(--text-sub); font-size: 15px; }
  .facts :global(.code code) { white-space: normal; overflow-wrap: anywhere; }
  .facts ul { margin: 0; padding-left: 18px; }
  .facts li + li { margin-top: 4px; }
  .section.first { margin-top: 40px; }
  .shot { display: block; max-width: 100%; height: auto; margin-top: 16px; border: 1px solid var(--border); border-radius: var(--radius); }
  .example-document, .example-empty { padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .example-label { font-size: 14px; color: var(--text-mute); margin-bottom: 16px; }
  .example-document h3 { font-size: 20px; margin-bottom: 24px; }
  .example-document dl { margin: 0; display: grid; gap: 16px; }
  .example-document dl > div { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 16px; }
  .example-document dt { font-size: 14px; font-weight: 700; padding-top: 2px; }
  .example-document dd { margin: 0; color: var(--text-sub); font-size: 16px; }
  .end { margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .end a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }
  @media (max-width: 959px) {
    .layout { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'summary' 'content'; }
    .summary { position: static; margin-top: 24px; }
    .content { max-width: none; }
    .head { padding-bottom: 0; border-bottom: 0; }
  }
  @media (max-width: 639px) {
    .back { margin-top: 16px; }
    .head { display: block; }
    .detail-icon { width: 48px; height: 48px; margin-bottom: 16px; }
    h1 { font-size: 28px; }
    .section.first { margin-top: 32px; }
    .example-document, .example-empty { padding: 24px 16px; }
    .example-document dl > div { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; }
  }
</style>
