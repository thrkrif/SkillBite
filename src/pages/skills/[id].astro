---
import { readFileSync, existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import FeatureTable from '../../components/FeatureTable.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import skills from '../../data/skills.json';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { id: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;

const file = `skills/${skill.id}/SKILL.md`;
const preview = existsSync(file) ? readFileSync(file, 'utf-8').split('\n').slice(0, 14).join('\n') : '';
---
<Base title={`${skill.title} | Skillbite`} description={skill.summary} narrow>
  <a class="back" href="/">← 목록으로</a>

  <header class="head">
    <div class="title-row">
      <span class="icon" aria-hidden="true"><img src={skill.icon} alt="" width="28" height="28" /></span>
      <h1>{skill.title}</h1>
    </div>
    <p class="sub">{skill.summary}</p>
    <div class="cta">
      <a class="btn" href={skill.downloadUrl} download>스킬 파일 다운로드</a>
      <span class="meta">무료 · 가입 없음 · 파일 1개</span>
    </div>
  </header>

  <SafetyBox preview={preview} />

  <section class="section">
    <h2>이런 결과물이 나옵니다</h2>
    {skill.exampleImages.length > 0
      ? skill.exampleImages.map((src) => (
          <a href={src} target="_blank" rel="noopener noreferrer"><img class="shot" src={src} alt={`${skill.title} 결과물 예시`} /></a>
        ))
      : <p class="meta">예시 이미지를 준비하고 있습니다.</p>}
  </section>

  <FeatureTable requirements={skill.requirements} capabilities={skill.capabilities} />
  <Steps skill={skill} />
  <Faq faqs={skill.faqs} />

  <div class="section bottom">
    <a class="btn" href={skill.downloadUrl} download>스킬 파일 다운로드</a>
  </div>
</Base>

<style>
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-top: 16px; }
  .head { padding: 16px 0 32px; display: flex; flex-direction: column; gap: 12px; }
  .title-row { display: flex; align-items: center; gap: 16px; }
  .icon {
    flex: none; display: flex; align-items: center; justify-content: center; width: 48px; height: 48px;
    border-radius: var(--radius); background: #eef3ff;
  }
  .sub { color: var(--text-sub); }
  .cta { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 8px; }
  .shot { display: block; max-width: 100%; border: 1px solid var(--border); border-radius: var(--radius); }
  .bottom { text-align: center; }
  @media (max-width: 639px) {
    .btn { width: 100%; }
  }
</style>
