---
import { readFileSync, existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import FeatureTable from '../../components/FeatureTable.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import skills from '../../data/skills.json';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { id: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;

const file = `skills/${skill.id}/SKILL.md`;
const preview = existsSync(file) ? readFileSync(file, 'utf-8').split('\n').slice(0, 14).join('\n') : '';
---
<Base title={`${skill.title} | Skillbite`} description={skill.summary} narrow>
  <a class="back" href="/#skills">← 스킬 목록으로</a>
  <header class="head">
    <span class="icon-surface detail-icon" aria-hidden="true"><img src={skill.icon} alt="" width="36" height="36" /></span>
    <div class="heading-content">
      <span class="category">{skill.category}</span>
      <h1>{skill.title}</h1>
      <p class="sub">{skill.summary}</p>
      <div class="tags">{skill.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
      <div class="cta">
        <a class="btn" href={skill.downloadUrl} download><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg>스킬 파일 다운로드</a>
        <span class="meta">무료 · 가입 없음 · ZIP 파일 1개</span>
      </div>
    </div>
  </header>
  <SafetyBox preview={preview} />
  <section class="section" aria-labelledby="example-title">
    <h2 id="example-title">이런 결과물이 나옵니다</h2>
    {skill.exampleImages.length > 0
      ? skill.exampleImages.map((src) => (
          <a href={src} target="_blank" rel="noopener noreferrer"><img class="shot" src={src} alt={`${skill.title} 결과물 예시`} loading="lazy" /></a>
        ))
      : skill.examplePreview
        ? <article class="example-document">
            <p class="example-label">{skill.examplePreview.label}</p>
            <h3>{skill.examplePreview.title}</h3>
            <dl>{skill.examplePreview.paragraphs.map((paragraph) => <div><dt>{paragraph.label}</dt><dd>{paragraph.text}</dd></div>)}</dl>
          </article>
        : <div class="example-empty"><p class="meta">실제 결과물 예시를 준비하고 있습니다.</p></div>}
  </section>
  <FeatureTable requirements={skill.requirements} capabilities={skill.capabilities} />
  <Steps skill={skill} />
  <Faq faqs={skill.faqs} />
  <section class="section bottom" aria-labelledby="download-title">
    <h2 id="download-title">이제 Claude에 추가해 보세요.</h2>
    <p>파일을 내려받고 위 안내에 따라 시작해 보세요.</p>
    <a class="btn" href={skill.downloadUrl} download>스킬 파일 다운로드</a>
    <span class="meta">무료 · 가입 없음 · ZIP 파일 1개</span>
  </section>
</Base>
<style>
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-top: 24px; color: var(--text-sub); text-decoration: none; font-size: 14px; }
  .back:hover { color: var(--accent-hover); }
  .head { padding: 24px 0 32px; display: flex; align-items: flex-start; gap: 24px; }
  .detail-icon { width: 72px; height: 72px; flex: none; margin-top: 24px; }
  .heading-content { min-width: 0; flex: 1; }
  .category { display: inline-flex; padding: 0 8px; min-height: 24px; align-items: center; border-radius: 8px; background: var(--accent-soft); color: var(--accent-hover); font-size: 14px; font-weight: 700; margin-bottom: 8px; }
  h1 { font-size: 40px; line-height: 1.3; letter-spacing: -0.03em; }
  .sub { margin-top: 12px; color: var(--text-sub); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .cta { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 24px; }
  .btn { gap: 12px; }
  .shot { display: block; max-width: 100%; height: auto; margin-top: 16px; border: 1px solid var(--border); border-radius: var(--radius); }
  .example-document, .example-empty { padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .example-label { font-size: 14px; color: var(--text-mute); margin-bottom: 16px; }
  .example-document h3 { font-size: 20px; margin-bottom: 24px; }
  dl { margin: 0; display: grid; gap: 16px; }
  dl > div { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 16px; }
  dt { font-size: 14px; font-weight: 700; padding-top: 2px; }
  dd { margin: 0; color: var(--text-sub); font-size: 16px; }
  .bottom { text-align: center; padding: 32px 24px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .bottom p { color: var(--text-sub); margin: 8px 0 24px; }
  .bottom .meta { display: block; margin-top: 16px; }
  @media (max-width: 639px) {
    .back { margin-top: 16px; }
    .head { display: block; padding-top: 16px; }
    .detail-icon { width: 56px; height: 56px; margin: 0 0 16px; }
    h1 { font-size: 30px; }
    .btn { width: 100%; }
    .cta { gap: 12px; }
    .example-document, .example-empty { padding: 24px 16px; }
    dl > div { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; }
  }
</style>
