---
import Base from '../layouts/Base.astro';
import SkillList from '../components/SkillList.astro';
import skills from '../data/skills.json';

const steps = [
  { title: '파일 받기', text: '고른 스킬 페이지에서 파일을 내려받아요.' },
  { title: '지정된 위치로 옮기기', text: '다운받은 스킬 파일을 Claude가 인식할 수 있는 위치로 옮깁니다. 위치와 방법은 스킬 페이지에 단계별로 있어요.' },
  { title: '명령어 입력', text: 'Claude에 /스킬 이름과 [내용]을 입력하면 자동화를 시작해요.' },
];
---
<Base>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">반복되는 업무,<br />파일 하나로 시작하세요.</h1>
    <p class="intro-text">자동화를 어렵게 생각하지 마세요.<br />
      스킬은 AI에게 일하는 방법을 알려주는 파일이에요. <br>
      지정된 위치에 파일을 저장하면, Claude가 글 초안을 만들어 줘요.<br />
    </p>
    <p class="intro-cost">스킬 파일은 무료이고 가입도 필요 없어요. 다만 Claude 유료 구독은 따로 필요해요.</p>
  </section>

  <section class="catalog" id="skills" aria-labelledby="skills-title">
    <h2 id="skills-title">어떤 일을 도와드릴까요?</h2>
    <SkillList skills={skills} />
  </section>

  <section class="how-it-works" id="how-it-works" aria-labelledby="how-title">
    <h2 id="how-title">처음이라도, 순서대로 따라오세요.</h2>
    <ol class="steps">
      {steps.map((step, index) => (
        <li>
          <span class="step-number" aria-hidden="true">{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .intro { max-width: 46rem; padding-block: 72px 56px; }
  .intro h1 { font-size: 52px; line-height: 1.2; letter-spacing: -.04em; text-wrap: balance; }
  .intro-text { max-width: 36rem; margin-top: 24px; color: var(--text-sub); font-size: 18px; line-height: 1.75; word-break: keep-all; text-wrap: pretty; }
  .intro-cost { max-width: 36rem; margin-top: 12px; color: var(--text); font-size: 16px; font-weight: 600; line-height: 1.7; word-break: keep-all; }
  .catalog h2, .how-it-works h2 { margin-bottom: 20px; font-size: 24px; letter-spacing: -.03em; }
  .how-it-works { margin-top: 80px; padding-top: 40px; border-top: 1px solid var(--border); }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 0; padding: 0; list-style: none; }
  .steps li { padding-top: 16px; border-top: 2px solid var(--text); }
  .step-number { display: block; margin-bottom: 8px; color: var(--text-mute); font-size: 14px; font-weight: 700; }
  .steps h3 { font-size: 18px; letter-spacing: -.02em; }
  .steps p { margin-top: 8px; color: var(--text-sub); font-size: 15px; line-height: 1.65; word-break: keep-all; }
  @media (max-width: 859px) and (min-width: 600px) { .steps { gap: 24px; } }
  @media (max-width: 859px) {
    .intro { padding-block: 48px 40px; }
    .intro h1 { font-size: 38px; }
    .intro-text { font-size: 17px; }
    .how-it-works { margin-top: 56px; }
  }
  @media (max-width: 599px) {
    .steps { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
