---
import Base from '../layouts/Base.astro';
import SkillGrid from '../components/SkillGrid.astro';
import skills from '../data/skills.json';
---
<Base>
  <section class="hero">
    <h1>파일 하나로 시작하는 AI 활용</h1>
    <p>클로드 유료 구독만 있으면 바로 쓸 수 있는 스킬을 모았습니다.</p>
  </section>
  <SkillGrid skills={skills} />
</Base>

<style>
  .hero { padding: 48px 0 32px; display: flex; flex-direction: column; gap: 8px; }
  .hero p { color: var(--text-sub); }
</style>
