---
const { text } = Astro.props;
---
<div class="copy-group">
  <div class="code"><code>{text}</code><button class="copy" type="button" data-copy={text} hidden>복사</button></div>
  <span class="copy-status" role="status" aria-live="polite"></span>
</div>
<style>
  button[hidden] { display: none; }
  .copy-group { min-width: 0; }
  .copy-status { display: block; color: var(--text-mute); font-size: 14px; }
  .copy-status:empty { display: none; }
  .copy-status:not(:empty) { margin-top: 8px; }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      const status = btn.closest('.copy-group')?.querySelector<HTMLElement>('.copy-status');
      if (!status) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        status.textContent = '복사했어요';
      } catch {
        status.textContent = '복사하지 못했어요. 위 글자를 직접 선택해 복사해 주세요.';
      }
    });
  });
</script>
