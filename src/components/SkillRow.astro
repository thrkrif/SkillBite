---
const { skill } = Astro.props;
const search = [skill.title, skill.summary, skill.category, ...skill.tags].join(' ').toLowerCase();
---
<li class="item" data-category={skill.category} data-search={search}>
  <a class="row" href={`/skills/${skill.id}`}>
    <span class="icon-surface" aria-hidden="true"><img src={skill.icon} alt="" width="28" height="28" /></span>
    <span class="body">
      <span class="title">{skill.title}</span>
      <span class="summary">{skill.summary}</span>
      <span class="tags">
        <span class="tag">{skill.category}</span>
        {skill.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
      </span>
    </span>
    <code class="command">{skill.command}</code>
    <span class="go" aria-hidden="true">자세히 보기<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg></span>
  </a>
</li>

<style>
  .item + .item { border-top: 1px solid var(--border); }
  .row { display: grid; grid-template-columns: 48px minmax(0, 1fr) minmax(0, 15rem) auto; align-items: center; gap: 20px; padding: 20px 24px; color: var(--text); text-decoration: none; }
  .row:hover { background: var(--surface-soft); }
  .row:hover .title { text-decoration: underline; text-underline-offset: 5px; }
  .row:focus-visible { outline-offset: -3px; }
  .body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .title { font-size: 18px; font-weight: 600; line-height: 1.5; letter-spacing: -.02em; word-break: keep-all; }
  .summary { color: var(--text-sub); font-size: 15px; line-height: 1.6; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tag { padding: 1px 8px; border: 1px solid var(--border); border-radius: 4px; color: var(--text-sub); font-size: 13px; line-height: 1.6; }
  .command { justify-self: end; max-width: 100%; padding: 6px 10px; overflow: hidden; background: var(--surface-soft); border-radius: 4px; color: var(--text-sub); font-family: var(--mono); font-size: 13px; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
  .go { display: inline-flex; align-items: center; gap: 2px; color: var(--text-sub); font-size: 14px; font-weight: 600; white-space: nowrap; }
  .row:hover .go { color: var(--text); }
  @media (max-width: 859px) {
    .row { grid-template-columns: 48px minmax(0, 1fr); align-items: start; gap: 12px 16px; padding: 20px; }
    .command { grid-column: 2; grid-row: 2; justify-self: start; margin-top: -4px; white-space: normal; overflow-wrap: anywhere; text-overflow: clip; }
    .go { grid-column: 2; grid-row: 3; justify-self: start; }
  }
  @media (max-width: 400px) { .row { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; padding: 16px; } .icon-surface { width: 40px; height: 40px; } }
</style>
