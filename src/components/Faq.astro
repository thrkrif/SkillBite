---
const { faqs } = Astro.props;
---
<section class="section" aria-labelledby="faq-title">
  <h2 id="faq-title">자주 막히는 점</h2>
  <div class="list">{faqs.map((f) => <details class="item"><summary><span>{f.q}</span><span class="indicator" aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div>
</section>
<style>
  .list { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .item + .item { border-top: 1px solid var(--border-soft); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; padding: 16px 24px; list-style: none; font-size: 16px; font-weight: 600; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  details[open] summary { color: var(--text); }
  .indicator { font-size: 20px; flex: none; }
  details[open] .indicator { font-size: 0; }
  details[open] .indicator::after { content: '−'; font-size: 20px; }
  p { padding: 0 24px 24px; color: var(--text-sub); font-size: 16px; overflow-wrap: anywhere; }
</style>
