---
const { skill } = Astro.props;
---
<a class="card" href={`/skills/${skill.id}`} data-category={skill.category}>
  <span class="card-top">
    <span class="icon-surface" aria-hidden="true"><img src={skill.icon} alt="" width="28" height="28" /></span>
    <span class="chip accent">{skill.category}</span>
  </span>
  <h3 class="title">{skill.title}</h3>
  <p class="summary">{skill.summary}</p>
  <span class="card-bottom">
    <span class="tags">
      {skill.tags.slice(0, 2).map((tag, index) => <span class:list={['chip', { accent: index === 0 }]}>{tag}</span>)}
    </span>
    <svg class="card-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7" /></svg>
  </span>
</a>

<style>
  .card { display: flex; flex-direction: column; min-width: 0; min-height: 280px; height: 100%; padding: 28px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); text-decoration: none; }
  .card:hover, .card:focus-visible { border-color: var(--accent); }
  .card:hover .title, .card:focus-visible .title { color: var(--accent-hover); }
  .card-top { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .card-top .chip { font-size: 14px; font-weight: 600; }
  .title { font-size: 20px; font-weight: 700; line-height: 1.5; letter-spacing: -.025em; }
  .summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 8px; font-size: 15px; line-height: 1.6; color: var(--text-sub); }
  .card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 24px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .card-arrow { flex: none; color: var(--accent-hover); }
  @media (max-width: 639px) { .card { padding: 24px; } }
</style>
