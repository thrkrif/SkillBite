---
import SkillCard from './SkillCard.astro';
import EmptyCard from './EmptyCard.astro';

const { skills } = Astro.props;
const categories = [...new Set(skills.map((skill) => skill.category))];
const showFilter = skills.length >= 3;
---
<div data-skill-catalog>
  {showFilter && (
    <div class="filters" role="group" aria-label="카테고리" hidden>
      <button class="chip" type="button" data-filter="" aria-pressed="true">전체</button>
      {categories.map((category) => <button class="chip" type="button" data-filter={category} aria-pressed="false">{category}</button>)}
    </div>
  )}
  {skills.length === 0 && <p class="empty-message">준비된 스킬이 아직 없습니다.</p>}
  <div class="grid">
    {skills.map((skill) => <SkillCard skill={skill} />)}
    <EmptyCard />
  </div>
  <div class="filter-empty" hidden>
    <p>이 분류에 해당하는 스킬이 아직 없습니다.</p>
    <button type="button" data-show-all>전체 스킬 보기</button>
  </div>
</div>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .filters .chip { min-height: 44px; padding: 0 16px; border: 1px solid var(--border); cursor: pointer; }
  .filters .chip[aria-pressed='true'] { background: var(--text); color: var(--surface); border-color: var(--text); font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .empty-message { margin-bottom: 16px; color: var(--text-sub); }
  .filter-empty { margin-top: 24px; padding: 24px; border: 1px solid var(--border); border-radius: var(--radius); }
  .filter-empty button { min-height: 44px; margin-top: 8px; padding: 0; border: 0; background: none; color: var(--accent-hover); font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 640px) and (max-width: 1023px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-skill-catalog]').forEach((catalog) => {
    const filters = catalog.querySelector<HTMLElement>('.filters');
    if (!filters) return;
    filters.hidden = false;
    const buttons = catalog.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = catalog.querySelectorAll<HTMLElement>('.card');
    const empty = catalog.querySelector<HTMLElement>('.filter-empty');
    const applyFilter = (category: string) => {
      let visible = 0;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === category)));
      cards.forEach((card) => {
        card.hidden = !!category && card.dataset.category !== category;
        if (!card.hidden) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    };
    buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter ?? '')));
    catalog.querySelector('[data-show-all]')?.addEventListener('click', () => applyFilter(''));
  });
</script>
