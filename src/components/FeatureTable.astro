---
const { requirements, capabilities } = Astro.props;
---
<section class="section requirements" aria-labelledby="requirements-title">
  <div><h2 id="requirements-title">준비물</h2><ul class="checklist">{requirements.map((r) => <li>{r}</li>)}</ul></div>
  <div class="capabilities"><h3>기능별로 필요한 것</h3>
    <p class="meta">위 준비물 외에 필요한 추가 연결입니다.</p>
    <div class="scroll" role="region" aria-label="기능별 추가 연결" tabindex="0"><table>
      <thead><tr><th scope="col">기능</th><th scope="col">추가로 필요한 것</th></tr></thead>
      <tbody>{capabilities.map((c) => <tr class:list={{ warn: c.needs !== '없음' }}><th scope="row">{c.label}</th><td>{c.needs === '없음' ? '추가 연결 없음' : c.needs}</td></tr>)}</tbody>
    </table></div>
  </div>
</section>
<style>
  .requirements { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px; }
  h2 { margin-bottom: 16px; }
  .checklist { margin: 0; padding-left: 20px; font-size: 15px; color: var(--text-sub); }
  .checklist li + li { margin-top: 8px; }
  h3 { font-size: 17px; margin-bottom: 8px; }
  .capabilities .meta { margin-bottom: 12px; }
  .scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); }
  th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--border-soft); font-size: 14px; }
  th + th, td { border-left: 1px solid var(--border-soft); }
  thead th { background: var(--surface-soft); }
  tbody th { font-weight: 600; }
  tbody tr:last-child > * { border-bottom: 0; }
  tr.warn > * { background: var(--warn-bg); color: var(--warn-text); }
  @media (max-width: 639px) { .requirements { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
</style>
