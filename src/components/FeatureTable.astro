---
const { capabilities } = Astro.props;
---
<section class="section" aria-labelledby="capabilities-title">
  <h2 id="capabilities-title">기능별로 필요한 것</h2>
  <p class="meta">Claude 유료 요금제 외에, 기능마다 필요한 추가 연결입니다.</p>
  <div class="scroll" role="region" aria-label="기능별 추가 연결" tabindex="0"><table>
    <thead><tr><th scope="col">기능</th><th scope="col">추가로 필요한 것</th></tr></thead>
    <tbody>{capabilities.map((c) => <tr><th scope="row">{c.label}</th><td class:list={{ need: c.needs !== '없음' }}>{c.needs === '없음' ? '추가 연결 없음' : c.needs}</td></tr>)}</tbody>
  </table></div>
</section>
<style>
  .meta { margin-bottom: 12px; }
  .scroll { overflow-x: auto; border-top: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 12px 16px 12px 0; border-bottom: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  thead th { color: var(--text-mute); font-size: 13px; font-weight: 700; }
  tbody th { font-weight: 600; width: 45%; }
  td { color: var(--text-sub); }
  td.need { color: var(--text); font-weight: 600; }
</style>
